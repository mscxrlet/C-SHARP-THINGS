using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Graphics;
using System;
namespace TestSup2
{
class Explosion
{
//A private field explosionTexture type Texture2D
//Texture2D is used to store images.
Texture2D explosionTexture;
//A private field explosionDisplay and explosionSource type Rectangle
//Rectangle is used for storing location(x-axis and y-axis) and size(width and
height)
Rectangle explosionDisplay, explosionSource;
//A private field explosionColor type Color
//Color is used for tinting of image
Color explosionColor;
//A private field explosionSourcePosition type Point
//Point is used for position of the rectangle
Point explosionSourcePosition;
//A private field playExplosion type bool
//Used for checking if the animation is done
bool playExplosion;
//Explosion Constructor for initializing all the private fields
public Explosion(Texture2D explosionTexture, Rectangle explosionDisplay,
Rectangle explosionSource, Color explosionColor)
{
this.explosionTexture = explosionTexture;
this.explosionDisplay = explosionDisplay;
this.explosionSource = explosionSource;
this.explosionColor = explosionColor;
explosionSourcePosition = new Point(0, 0);
playExplosion = true;
}
//Property that will be used for retrieving the data from private fields except
for explosionSourcePosition
public Texture2D ExplosionTexture { get { return explosionTexture; } }
public Rectangle ExplosionDisplay { get { return explosionDisplay; } }
public Rectangle ExplosionSource { get { return explosionSource; } }
public Color ExplosionColor { get { return explosionColor; } }
public bool PlayExplosion { get { return playExplosion; } set { playExplosion =
value; } }
//This method will be used to play the explosion animation by moving the position
of explosionSource
//Rectangle.
public void animateExplosion()
{
if(explosionSourcePosition.X < explosionSource.Width * 7)
{
explosionSourcePosition.X += explosionSource.Width;
}
else
{
explosionSourcePosition.Y += explosionSource.Height;
explosionSourcePosition.X = 0;
if (explosionSourcePosition.Y > explosionSource.Height * 4)
{
playExplosion = false;
}
}
explosionSource.Location = explosionSourcePosition;
}
}
}
