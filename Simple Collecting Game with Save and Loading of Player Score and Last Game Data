using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Graphics;
using System;
namespace TestCatchingGame
{
class GameLabels
{
//A private field gameFont type SpriteFont
SpriteFont gameFont;
//A private field gameTime and gameScore type string
string gameTime, gameScore;
//A private field timePosition and scorePosition type Vector2
Vector2 timePosition, scorePosition;
//A private field timeColor and scoreColor type Color
Color timeColor, scoreColor;
//A private field timeCtr and scoreCtr type int
int timeCtr, scoreCtr;
//GameLabels Constructor
public GameLabels(SpriteFont gameFont, string gameTime, string gameScore, Vector2
timePosition, Vector2 scorePosition, Color timeColor, Color scoreColor, int timeCtr, int
scoreCtr)
{
this.gameFont = gameFont;
this.gameTime = gameTime;
this.gameScore = gameScore;
this.timePosition = timePosition;
this.scorePosition = scorePosition;
this.timeColor = timeColor;
this.scoreColor = scoreColor;
this.timeCtr = timeCtr;
this.scoreCtr = scoreCtr;
}
//Property of gameFont. Retrieving only
public SpriteFont GameFont { get => gameFont; }
//Property of gameTime. Retrieving only
public string GameTime { get => gameTime; }
//Property of gameScore. Retrieving only
public string GameScore { get => gameScore; }
//Property of timePosition. Retrieving only
public Vector2 TimePosition { get => timePosition; }
//Property of scorePosition. Retrieving only
public Vector2 ScorePosition { get => scorePosition; }
//Property of timeColor. Retrieving only
public Color TimeColor { get => timeColor; }
//Property of scoreColor. Retrieving only
public Color ScoreColor { get => scoreColor; }
//Property of timeCtr. Retrieving only
public int TimeCtr { get => timeCtr; }
//Method for decrementing the time.
public void gameTimeSetup()
{
if(timeCtr > 0)
{
timeCtr--;
}
gameTime = "Time: " + timeCtr;
}
//Method for incrementing the score.
public void scoreSetup()
{
scoreCtr++;
gameScore = "Score: " + scoreCtr;
}
}
}
