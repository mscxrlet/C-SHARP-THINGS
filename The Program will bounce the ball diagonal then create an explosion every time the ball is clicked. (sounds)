using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Graphics;
using System;
namespace TestSup2
{
class Ball
{
//A private field ballTexture type Texture2D
Texture2D ballTexture;
//A private field ballRectangle type Rectangle
Rectangle ballRectangle;
//A private field ballColor type Color
Color ballColor;
//A private field boundaryX and boundaryY type int. Boundary for ball movement.
int boundaryX, boundaryY;
//A private field directionX and directionY type bool. direction for ball
movement.
bool directionX, directionY;
//Ball Constructor for initializing all the private fields
public Ball(Texture2D ballTexture, Rectangle ballRectangle, Color ballColor, int
boundaryX, int boundaryY)
{
this.ballTexture = ballTexture;
this.ballRectangle = ballRectangle;
this.ballColor = ballColor;
this.boundaryX = boundaryX;
this.boundaryY = boundaryY;
directionX = true;
directionY = true;
}
//Property that will be used for retrieving the data from private fields except
for int and bool type
public Texture2D BallTexture { get { return ballTexture; } }
public Rectangle BallRectangle { get { return ballRectangle; } }
public Color BallColor { get { return ballColor; } }
//This method will be used for ball movement
public void BallMove()
{
if(ballRectangle.X <= 0)
{
directionX = true;
}else if(ballRectangle.X >= boundaryX)
{
directionX = false;
}
{
if (ballRectangle.Y <= 0)
directionY = true;
}
else if (ballRectangle.Y >= boundaryY)
{
directionY = false;
}
{
if (directionX)
ballRectangle.X += 2;
}
else
{
ballRectangle.X -= 2;
}
{
if (directionY)
ballRectangle.Y += 2;
}
else
{
ballRectangle.Y -= 2;
}
}
}
}
