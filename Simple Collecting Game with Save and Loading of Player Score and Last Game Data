using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Audio;
using Microsoft.Xna.Framework.Graphics;
using Microsoft.Xna.Framework.Input;
using System;
using System.IO;
using System.Xml.Serialization;
namespace TestCatchingGame
{
public class Game1 : Game
{
GraphicsDeviceManager graphics;
SpriteBatch spriteBatch;
//A private field player type Player. All the details needed for the player
avatar will be stored here.
Player player;
//A private field target type Targets. All the details needed for the target
avatar will be stored here.
Targets target;
//A private field gameLabels type GameLabels. All the details for the scoring and
game time will be stored here.
GameLabels gameLabels;
//A private field timeDelay type int. This will be used for adjusting the count
in game time.
int timeDelay;
//A private field gameBackgroundMusic and gameHit type SoundEffects. Used for
accessing sound assets.
SoundEffect gameBackgroundMusic,gameHit;
//A private field gameBackgroundMusicInstance and gameHitInstance type
SoundEffectInstance. Used to manipulate sounds effeciently.
SoundEffectInstance gameBackgroundMusicInstance,gameHitInstance;
//A privet field gameStart and keyPress type bool.
bool gameStart,keyPress;
//A private field playerName type string
string playerName;
public Game1()
{
graphics = new GraphicsDeviceManager(this);
Content.RootDirectory = "Content";
}
//Initialization for player, target, gameLabels, and timeDelay fields.
protected override void Initialize()
{
Random rand = new Random();
Texture2D playerTexture = Content.Load<Texture2D>("TheProfessor");
Rectangle playerDisplay = new
Rectangle(rand.Next(0,Window.ClientBounds.Width-50), rand.Next(0,
Window.ClientBounds.Height - 50), 50, 50);
Rectangle playerSource = new Rectangle(0, 0, playerTexture.Width / 9,
playerTexture.Height / 4);
player = new Player(playerTexture,
playerDisplay,
playerSource,
Color.White,
new int[] { Window.ClientBounds.Width - 50, Window.ClientBounds.Height -
50 });
target = null;
SpriteFont gameFont = Content.Load<SpriteFont>("GameFont");
Vector2 timePosition = new Vector2(Window.ClientBounds.Width/2-50, 20);
Vector2 scorePosition = new Vector2(10, 20);
gameLabels = new GameLabels(gameFont, "", "", timePosition, scorePosition,
Color.White, Color.Black, 30, -1);
gameLabels.gameTimeSetup();
gameLabels.scoreSetup();
timeDelay = 0;
gameStart = false;
playerName = "";
keyPress = false;
base.Initialize();
}
protected override void LoadContent()
{
spriteBatch = new SpriteBatch(GraphicsDevice);
//Initialization of gameBackgroundMusic
gameBackgroundMusic = Content.Load<SoundEffect>("GBack");
//Initialization of gameBackgroundMusicInstance using gameBackgroundMusic
gameBackgroundMusicInstance = gameBackgroundMusic.CreateInstance();
//Setting the gameBackgroundMusicInstance to loop
gameBackgroundMusicInstance.IsLooped = true;
//Playing the background music using gameBackgroundMusicInstance
gameBackgroundMusicInstance.Play();
}
protected override void UnloadContent()
{
}
protected override void Update(GameTime gameTime)
{
//Condition for starting the game
if (gameStart)
{
//checks if the timeCtr field of gameLabels is greater than 0. Used to
stop the game once the time reach 0.
if (gameLabels.TimeCtr > 0)
{
//Used for passing the Keys in playerMove and playerAnimation method
of player.
foreach (Keys k in Keyboard.GetState().GetPressedKeys())
{
player.playerMove(k);
player.playerAnimation(k);
break;
}
create:
//check if the value of target is equal to null. Used for creating
new box.
if (target == null)
{
the rectangle of the player
Random rand = new Random();
Texture2D targetTexture = Content.Load<Texture2D>("Box");
Rectangle boxRectangle;
//Iterate if the rectangle of the box collide or intersects with
do
{
boxRectangle = new Rectangle(rand.Next(30,
Window.ClientBounds.Width - 50), rand.Next(30, Window.ClientBounds.Height - 50), 50, 50);
//check if the rectangle of boxRectangle and
playerRectangleDisplay of player intersects.
if (!boxRectangle.Intersects(player.PlayerRectangleDisplay))
{
break;
}
} while (true);
//target field initialization
target = new Targets(targetTexture, boxRectangle, Color.White);
}
//check if the rectangle of targetDisplay of target and
playerRectangleDisplay of player intersects.
if (player.PlayerRectangleDisplay.Intersects(target.TargetDisplay))
{
//Initialization of gameHit
gameHit = Content.Load<SoundEffect>("hit");
//Initialization of gameHitInstance using gameHit
gameHitInstance = gameHit.CreateInstance();
//Playing the sound effects for hit using gameHitInstance
gameHitInstance.Play();
gameLabels.scoreSetup();
target = null;
goto create;
}
//Condition of time delay
if (timeDelay > 60)
{
timeDelay = 0;
gameLabels.gameTimeSetup();
}
timeDelay++;
//Condition to save the player name and score to HighestScore file.
if(gameLabels.TimeCtr == 0)
{
//Creation of file HighestScore. True parameters means it will
not create a new one if the HighestScore already exist.
StreamWriter saveData = new StreamWriter("HighestScore", true);
//Write the player name and game score in a file.
saveData.WriteLine(playerName + "," + gameLabels.GameScore);
//Closing the file Stream
saveData.Close();
//Creating an Object of GameData that will be stored in a file.
GameData gd = new GameData();
//Assigning the value of the data that will be stored in the file
using GameData Object gd.
gd.lastPlayerPosition = player.PlayerRectangleDisplay;
gd.lastTargetPosition = target.TargetDisplay;
gd.lastScore = int.Parse(gameLabels.GameScore);
//Declaring an XmlSerializer and initialize it that will be used
as format once the GameData object stored in a file.
XmlSerializer sd = new XmlSerializer(typeof(GameData));
saveData = new StreamWriter("LastData");
//Saving the GameData object gd to a file in a XML format.
sd.Serialize(saveData, gd);
saveData.Close();
}
}
else
{
//Reset the game
if (Keyboard.GetState().IsKeyDown(Keys.S))
{
gameBackgroundMusic = null;
gameBackgroundMusicInstance.Stop();
Initialize();
}
}
}
else
{
//Allows to create a similar concept of a TextBox.
Keys[] input = Keyboard.GetState().GetPressedKeys();
if (!keyPress)
{
foreach (Keys k in input)
{
if (k == Keys.Back)
{
if (playerName.Trim() != "")
{
playerName = playerName.Substring(0, playerName.Length -
1);
}
}
else
{
char let = k.ToString()[0];
if (char.IsLetter(let))
{
playerName += let;
}
}
break;
}
keyPress = true;
}
else if(input.Length == 0)
{
keyPress = false;
}
//Key to press to start the game
if (Keyboard.GetState().IsKeyDown(Keys.Enter))
{
gameStart = true;
}
}
base.Update(gameTime);
}
{
protected override void Draw(GameTime gameTime)
GraphicsDevice.Clear(Color.CornflowerBlue);
spriteBatch.Begin();
if (gameStart)
{
//Player Display
spriteBatch.Draw(player.PlayerTexture, player.PlayerRectangleDisplay,
player.PlayerRectangleSource, player.PlayerColor);
if (target != null)
{
//Box Display
spriteBatch.Draw(target.TargetTexture, target.TargetDisplay,
target.TargetColor);
}
//Score Display
spriteBatch.DrawString(gameLabels.GameFont, "Score:
"+gameLabels.GameScore, gameLabels.ScorePosition, gameLabels.ScoreColor);
//Time Display
spriteBatch.DrawString(gameLabels.GameFont, gameLabels.GameTime,
gameLabels.TimePosition, gameLabels.TimeColor);
}
else
{
spriteBatch.DrawString(gameLabels.GameFont, "Player Name: " +
playerName, Vector2.Zero, Color.White);
spriteBatch.DrawString(gameLabels.GameFont, "Press Enter to Start the
Game", new Vector2(0, 50), Color.White);
//Checking if the file HighestScore already exists
if (File.Exists("HighestScore"))
{
//File Reading. Accessing the file HighestScore.
StreamReader loadData = new StreamReader("HighestScore");
int posY = 80;
spriteBatch.DrawString(gameLabels.GameFont, "Name
Score", new Vector2(0, posY), Color.White);
//Checking if the reading of the file is not in the end of file.
while (!loadData.EndOfStream)
{
posY += 30;
//loading the line of data of the file and convert it to
array using Split and assign it to data variable array.
string[] data = loadData.ReadLine().Split(',');
//Displaying the content of the file.
spriteBatch.DrawString(gameLabels.GameFont,data[0]+"
"+data[1], new Vector2(0, posY), Color.White);
}
loadData.Close();
//Declaring an XmlSerializer and initialize it that will be used
for instantiating a GameData object.
XmlSerializer ld = new XmlSerializer(typeof(GameData));
loadData = new StreamReader("LastData");
//Loading(instantiating) GameData object then stored in gd
variable type GameData.
GameData gd = (GameData)ld.Deserialize(loadData);
loadData.Close();
//Displaying the last player position, target position, and score
of the game.
spriteBatch.DrawString(gameLabels.GameFont, "Last Game Data", new
Vector2(250, 80), Color.White);
spriteBatch.DrawString(gameLabels.GameFont, "Last Player
Position: " + gd.lastPlayerPosition.Location, new Vector2(250, 110), Color.White);
spriteBatch.DrawString(gameLabels.GameFont, "Last Target
Position: " + gd.lastTargetPosition.Location, new Vector2(250, 140), Color.White);
spriteBatch.DrawString(gameLabels.GameFont, "Last Game Score: " +
gd.lastScore, new Vector2(250, 170), Color.White);
}
}
spriteBatch.End();
base.Draw(gameTime);
}
}
}
