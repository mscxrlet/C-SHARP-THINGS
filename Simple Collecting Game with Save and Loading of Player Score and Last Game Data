using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Graphics;
using Microsoft.Xna.Framework.Input;
using System;
namespace TestCatchingGame
{
class Player
{
//A private field playerTexture type Texture2D.
Texture2D playerTexture;
//A private field playerRectangleDisplay type Rectangle. This is for the
displacement in the Game Window.
Rectangle playerRectangleDisplay;
//A private field playerRectangleSource type Rectangle. This is for the portion
or part of the image going to be display in the Game Window.
Rectangle playerRectangleSource;
//A private field playerColor type Color.
Color playerColor;
//A private field playerBoundary array type int. This is for the Game Window
boundary.
int[] playerBoundary;
//Player class Constructor
public Player(Texture2D playerTexture, Rectangle playerRectangleDisplay,
Rectangle playerRectangleSource, Color playerColor,
int[] playerBoundary)
{
this.playerTexture = playerTexture;
this.playerRectangleDisplay = playerRectangleDisplay;
this.playerRectangleSource = playerRectangleSource;
this.playerColor = playerColor;
this.playerBoundary = playerBoundary;
}
//Property for playerTexture. Retrieve only
public Texture2D PlayerTexture {
get
{
return playerTexture;
}
}
//Property for playerRectangleDisplay. Retrieve only.
public Rectangle PlayerRectangleDisplay {
get { return playerRectangleDisplay; }
}
//Property for playerRectangleSource. Retrieve only.
public Rectangle PlayerRectangleSource {
get {
return playerRectangleSource;
}
}
//Property for playerColor. Retrieve only.
public Color PlayerColor
{
get
{
return playerColor;
}
}
//Method for player position in the screen. This method have Keys parameter that
identifies a particular key on a keyboard.
public void playerMove(Keys key)
{
//Assign the x-axis value of playerRectangleDisplay to moveX
int moveX = playerRectangleDisplay.X;
//Assign the y-axis value of playerRectangleDisplay to moveY
int moveY = playerRectangleDisplay.Y;
//check if the keys is equal to left arrow key
if (key == Keys.Left)
{
moveX -= 2;
}
//check if the keys is equal to right arrow key
if (key == Keys.Right)
{
moveX += 2;
}
//check if the keys is equal to up arrow key
if (key == Keys.Up)
{
moveY -= 2;
}
//check if the keys is equal to down arrow key
if (key == Keys.Down)
{
moveY += 2;
}
//check if the value of moveX is inside the Game Window
if (moveX > 0 && moveX < playerBoundary[0])
{
playerRectangleDisplay.X = moveX;
}
//check if the value of moveY is inside the Game Window
if (moveY > 0 && moveY < playerBoundary[1])
{
playerRectangleDisplay.Y = moveY;
}
}
//Method for player spritesheet animation in the screen. This method have Keys
parameter that identifies a particular key on a keyboard.
public void playerAnimation(Keys key)
{
//Assign the height value of playerRectangleSource to playerRow.
int playerRow = playerRectangleSource.Height;
//Assign the x-axis value of playerRectangleSource to animX.
int animX = playerRectangleSource.X;
//Assign the y-axis value of playerRectangleSource to animY.
int animY = playerRectangleSource.Y;
//check if the keys is equal to left arrow key
if (key == Keys.Left)
{
//Animating the second row of the spritesheet
playerRow *= 1;
animY = playerRow;
if(animX <= 0)
{
animX = playerRectangleSource.Width * 8;
}
else
{
animX -= playerRectangleSource.Width;
}
}
//check if the keys is equal to right arrow key
if (key == Keys.Right)
{
//Animating the fourth row of the spritesheet
playerRow *= 3;
animY = playerRow;
if (animX >= playerRectangleSource.Width * 8)
{
animX = 0;
}
else
{
animX += playerRectangleSource.Width;
}
}
//check if the keys is equal to up arrow key
if (key == Keys.Up)
{
//Animating the first row of the spritesheet
playerRow *= 0;
animY = playerRow;
if (animX <= 0)
{
animX = playerRectangleSource.Width * 8;
}
else
{
animX -= playerRectangleSource.Width;
}
}
//check if the keys is equal to down arrow key
if (key == Keys.Down)
{
//Animating the third row of the spritesheet
playerRow *= 2;
animY = playerRow;
if (animX >= playerRectangleSource.Width * 8)
{
animX = 0;
}
else
{
animX += playerRectangleSource.Width;
}
}
//Assigning the value of animX to the x-axis of playerRectangleSource
playerRectangleSource.X = animX;
//Assigning the value of animY to the y-axis of playerRectangleSource
playerRectangleSource.Y = animY;
}
}
}
