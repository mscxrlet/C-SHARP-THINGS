using Microsoft.Xna.Framework;
using Microsoft.Xna.Framework.Graphics;
using Microsoft.Xna.Framework.Input;
using System;
namespace TestSup2
{
public class Game1 : Game
{
GraphicsDeviceManager graphics;
SpriteBatch spriteBatch;
//A private field explosion type Explosion
//Explosion is used for animating and displaying explosion spritesheet
Explosion explosion;
//A private field ball type ball
//Explosion is used for displaying ball image
Ball ball;
public Game1()
{
graphics = new GraphicsDeviceManager(this);
Content.RootDirectory = "Content";
IsMouseVisible = true;
}
protected override void Initialize()
{
//Declaring and Initializing local variable for explosion field object
parameters
Texture2D explosionTexture = Content.Load<Texture2D>("Explosion");
Rectangle display = new Rectangle(0, 0, 100, 100);
Rectangle source = new Rectangle(0, 0, explosionTexture.Width / 8,
explosionTexture.Height / 4);
Color explosionTinting = Color.White;
explosion = new Explosion(explosionTexture, display, source,
explosionTinting);
//Declaring and Initializing local variable for explosion field object
parameters
Texture2D ballTexture = Content.Load<Texture2D>("Ball");
Rectangle ballDisplay = new Rectangle(40, 200, 50, 50);
Color ballColor = Color.White;
ball = new Ball(ballTexture, ballDisplay, ballColor,
Window.ClientBounds.Width - 50, Window.ClientBounds.Height - 50);
base.Initialize();
}
protected override void LoadContent()
{
spriteBatch = new SpriteBatch(GraphicsDevice);
}
protected override void UnloadContent()
{
}
protected override void Update(GameTime gameTime)
{
//Used for calling animateExplosion method of explosio field and check if the
animation is done then reset it.
if (explosion.PlayExplosion)
{
}
explosion.animateExplosion();
//Create an Explosion Object Everytime left mouse Button is Click the ball
if(Mouse.GetState().LeftButton == ButtonState.Pressed &&
ball.BallRectangle.Contains(Mouse.GetState().Position))
{
Texture2D explosionTexture = Content.Load<Texture2D>("Explosion");
Rectangle display = new Rectangle(Mouse.GetState().X, Mouse.GetState().Y,
100, 100);
Rectangle source = new Rectangle(0, 0, explosionTexture.Width / 8,
explosionTexture.Height / 4);
Color explosionTinting = Color.White;
explosion = new Explosion(explosionTexture, display, source,
explosionTinting);
//Applying Sound hit
SoundEffect hitEffect = Content.Load<SoundEffect>("hit");
SoundEffectInstance hitSound = hitEffect.CreateInstance();
hitSound.Play();
}
//Pause the animation if the right mouse button is clicked
if (Mouse.GetState().RightButton == ButtonState.Pressed)
{
explosion.PlayExplosion = false;
}
ball.BallMove();
base.Update(gameTime);
}
protected override void Draw(GameTime gameTime)
{
//Clears the Game Window everyframe.
GraphicsDevice.Clear(Color.CornflowerBlue);
//All sprites must be drawn between a SpriteBatch.Begin and a
SpriteBatch.End.
spriteBatch.Begin();
//Display the explosion effect using spriteBatch Draw method. All details
needed will came from
//explosion field.
spriteBatch.Draw(explosion.ExplosionTexture,
explosion.ExplosionDisplay,
explosion.ExplosionSource,
explosion.ExplosionColor);
//Display ball image while moving
spriteBatch.Draw(ball.BallTexture, ball.BallRectangle, ball.BallColor);
//Display The Ball Position
spriteBatch.DrawString(Content.Load<SpriteFont>("GameFont"),
"Ball Position: "+ball.BallRectangle.Location,
new Vector2(Window.ClientBounds.Width / 2 - 50, 10), Color.White);
//Display The Mouse Position
spriteBatch.DrawString(Content.Load<SpriteFont>("GameFont"),
"Mouse Position: " + Mouse.GetState().Position,
new Vector2(Window.ClientBounds.Width / 2 - 50, 40), Color.Green);
spriteBatch.End();
base.Draw(gameTime);
}
}
}
